# API Specific Exclusions

# Build Artifacts
dist/
dist-ssr/
*.log

# Scripts & Config
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependency folders
node_modules/
jspm_packages/

# Troubleshooting
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database artifacts: local dumps and generated migrations
# Schema source of truth is src/db/schema.ts; migrations can be
# regenerated locally with `drizzle-kit generate` if needed.
*.sql
drizzle/
